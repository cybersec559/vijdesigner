# Vercel AI Gateway key. Copy uses openai/gpt-5-mini.
# Worn portraits use google/gemini-2.5-flash-image.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Password for /studio
STUDIO_PASSWORD=

# Admin API token with write_products, read_products, read_publications,
# and write_publications. A priced publish creates or updates the Shopify
# product so Add to cart appears. Store domain comes from SHOPIFY_STORE_DOMAIN.
SHOPIFY_ADMIN_ACCESS_TOKEN=
